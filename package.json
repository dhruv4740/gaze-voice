{
  "name": "gaze-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "relay": "node server/relay.js",
    "tunnel": "ssh -o StrictHostKeyChecking=accept-new -R 80:localhost:5173 nokey@localhost.run",
    "tunnel:cf": "tools\\cloudflared.exe tunnel --url http://localhost:5173",
    "phone": "concurrently -k \"npm:relay\" \"npm:dev:host\"",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "sim": "node scripts/sim/jitter.mjs && node scripts/sim/gate.mjs && node scripts/sim/handkeys.mjs",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "qrcode": "^1.5.4",
    "webgazer": "^3.5.3",
    "ws": "^8.22.0"
  }
}
